#!/usr/bin/env bash
#
# commit-msg hook: validates Conventional Commits format.
#
# Installed via: git config core.hooksPath .githooks
# Run manually:  .githooks/commit-msg <path-to-commit-msg-file>
#
# Valid format:
#   <type>(<scope>): <subject>
#
#   [optional body]
#
#   [optional footer]
#
# Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
# Scopes: coords, worldgen, game, mapdump, ci, build, docs (optional)
# Breaking change: append ! after type/scope, e.g. feat(worldgen)!: ...

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Skip merge commits and fixup commits — these are generated by git itself.
if echo "$COMMIT_MSG" | grep -qE '^(Merge|fixup!|squash!)'; then
    exit 0
fi

# ------------- Validation -------------

TYPES="feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert"
SCOPES="coords|worldgen|game|mapdump|ci|build|docs"

# Pattern: type(scope)!: subject  OR  type!: subject  OR  type: subject
PATTERN="^($TYPES)(\(($SCOPES)\))?!?: .+"

SUBJECT_LINE=$(echo "$COMMIT_MSG" | head -n1)

if ! echo "$SUBJECT_LINE" | grep -qE "$PATTERN"; then
    echo ""
    echo "  ✗ Commit message does not follow Conventional Commits format."
    echo ""
    echo "  Expected: <type>(<scope>): <subject>"
    echo "  Got:      $SUBJECT_LINE"
    echo ""
    echo "  Valid types:  feat, fix, docs, style, refactor, perf, test,"
    echo "                build, ci, chore, revert"
    echo "  Valid scopes: coords, worldgen, game, mapdump, ci, build, docs"
    echo "                (scope is optional)"
    echo ""
    echo "  Examples:"
    echo "    feat(coords): add wrap-aware hex distance"
    echo "    fix(worldgen): sort boundaries before classification"
    echo "    docs: update ADR index"
    echo "    feat(worldgen)!: rename WorldParams to GenerationParams"
    echo ""
    echo "  See DOCUMENTATION_GUIDE.md §6 for the full convention."
    echo ""
    exit 1
fi

# Subject line length check (72-char hard limit).
SUBJECT_LENGTH=${#SUBJECT_LINE}
if [ "$SUBJECT_LENGTH" -gt 72 ]; then
    echo ""
    echo "  ✗ Subject line is $SUBJECT_LENGTH characters (limit: 72)."
    echo "  Shorten the subject and move detail to the body."
    echo ""
    exit 1
fi

# Subject must not end with a period.
if echo "$SUBJECT_LINE" | grep -qE '\.$'; then
    echo ""
    echo "  ✗ Subject line must not end with a period."
    echo ""
    exit 1
fi

# The word after the colon-space must be lowercase.
# Extract the subject text (everything after the ': ').
SUBJECT_TEXT=$(echo "$SUBJECT_LINE" | sed 's/^[^:]*: //')
FIRST_CHAR=$(echo "$SUBJECT_TEXT" | cut -c1)
if echo "$FIRST_CHAR" | grep -qE '[A-Z]'; then
    echo ""
    echo "  ✗ Subject must start with a lowercase letter."
    echo "  Got: '$SUBJECT_LINE'"
    echo ""
    exit 1
fi

exit 0
