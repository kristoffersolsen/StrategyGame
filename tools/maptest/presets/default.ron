// Default TuningParams — matches TuningParams::defaults().
// Copy this file, rename it, and edit values to create a named preset.
// Pass it to maptest or mapdump with --params <file>.
//
// Only the sub-structs you want to override need to be present.
// Omitted sub-structs use their defaults (e.g. omit `climate:` to use
// all climate defaults).
//
// level_proportions: [ocean, coast, low_land, mid_land, high_land, mountain]
//   Must have (land_level_count + 3) entries summing to 1.0.
// mineral_weights: [Ferrous, Precious, Gems, Hydrocarbons, Industrial]
//   Relative weights — normalised internally before sampling.
(
    tectonics: (
        // Step 1 — Plate seed placement
        target_plate_count: 17,

        // Step 3 — Plate properties
        motion_magnitude_min: 0.5,
        motion_magnitude_max: 1.5,
        mineral_weights: [4.0, 2.0, 1.0, 3.0, 4.0],
        plate_growth_rate_range: 3.0,
        clumping_index: 0.0,

        // Step 5 — Boundary classification
        convergence_threshold: 0.01,

        // Steps 6–7 — Elevation field
        continental_base_elevation: 0.1,
        oceanic_base_elevation: -0.3,
        intra_plate_noise_amplitude: 0.05,
        intra_plate_noise_frequency: 2.0,
        boundary_falloff_sigma: 1.0,
        boundary_strength_noise_amplitude: 0.0,
        boundary_strength_noise_frequency: 3.0,
        boundary_sigma_noise_amplitude: 0.0,
        boundary_sigma_noise_frequency: 3.0,
        mountain_elevation_boost: 0.4,
        coastal_mountain_boost: 0.2,
        subduction_trench_penalty: -0.3,
        island_arc_boost: 0.1,
        rift_valley_penalty: -1,
        mid_ocean_ridge_boost: 0.3,
        detail_noise_amplitude: 1.2, // around 3.5
        detail_noise_frequency: 8.0, // between 9-13
        detail_noise_octaves: 6,

        // Step 8 — Sea level + quantile thresholding
        land_level_count: 5,
        level_proportions: [0.35, 0.05, 0.15, 0.1, 0.15, 0.1, 0.05, 0.05],

        // Step 9 — Hills classification
        hill_influence_radius: 8,
        hill_near_boundary_threshold: -0.2,
        hill_interior_threshold: 0.55,
        hill_noise_frequency: 5.0,

        // Step 10 — Mountain pass carving
        // threshold > 1.0 disables the pass entirely.
        mountain_pass_threshold: 0.15,
        mountain_pass_noise_frequency: 10.0,
        mountain_pass_neighbor_aware: true,
        mountain_pass_min_mountain_neighbors: 3,
    ),
    climate: (
        // Step 1 — Temperature field
        equator_temperature: 1.0,
        pole_temperature: -0.5,
        elevation_lapse_rate: 0.2,
        climate_band_offset: 0.0,

        // Step 2 — Wind field
        wind_amplitude: 0.1,       // CFL cap is 0.25
        wind_noise_amplitude: 0.1,
        wind_noise_frequency: 4.0,  // raised from 0.5: torus circle radius = 1/(2π) × freq,
                                    // so 0.5 gives radius≈0.08 (negligible N-S wind), 4.0 gives ≈0.64

        // Step 3 — Evaporation + coastal source
        evaporation_rate: 1.0,
        evaporation_temp_floor: -0.2,
        evaporation_temp_scale: 0.2,
        coastal_moisture_factor: 1,
        moisture_cap: 50.0,

        // Steps 4–5 — Advection and precipitation
        base_precipitation_rate: 0.05, // lowered: each tile inland loses base_rate×capacity per iter;
                                        // at 0.04 moisture dies in ~10 tiles, at 0.004 it survives ~100
        temp_capacity_offset: 2,
        temp_capacity_scale: 1.0,
        orographic_factor: 0.05,     // raised: with low base_rate, mountains must capture the moisture
        max_precipitation_fraction: 0.8,

        // Step 4b — Evapotranspiration (land moisture recycling)
        evapotranspiration_rate: 0.01,

        // Step 4c — Isotropic diffusion (N-S moisture transport)
        diffusion_rate: 0.5,

        // Step 6 — Iteration count
        iteration_count_factor: 1.5,
        iteration_count_min: 500,
    ),
    hydrology: (
        // Steps 2–3 — Basin detection + sink resolution
        lake_basin_area_threshold: 50,

        // Step 5 — River identification
        river_flow_threshold: 0.04,
        major_river_flow_threshold: 0.22, // between 0.2 and 0.3

        // Step 6 — Floodplain marking
        floodplain_elevation_tolerance: 0.05,

        // Step 7 — Canyon carving
        canyon_flow_slope_threshold: 0.25,
        canyon_depth: 1,
    ),
    biomes: (
        // Step 2 — Table dimensions. These must match assets/worldgen/biome_table.ron.
        temperature_bin_count: 8,
        moisture_bin_count: 8,

        // Step 4 — River, floodplain, and lake-adjacent fertile overrides
        hydrology_override_strength: 0.8,

        // Step 5 — Optional single-tile-island smoothing
        smoothing_passes: 0,

        // Step 6 — Forest density feature noise
        forest_noise_frequency: 0.4,
        forest_noise_amplitude: 0.6,
    ),
    resources: (
        // Step 7 — Clustered luxury expansion
        cluster_expansion_attempts: 8,

        // Steps 4–7 — Shared Poisson-disk scatter rejection limit
        poisson_max_attempts: 30,
    ),
)
