// assets/worldgen/resources.ron
//
// Resource placement config for Stage 3.5.
//
// Resources are keyed by stable snake_case string IDs. These IDs are the
// authoritative identity for resources across saves and the network.
// Runtime handles are derived by sorting IDs alphabetically at load time
// and are never persisted.
//
// Rarity is the target fraction of eligible tiles before the Advanced
// resource_abundance multiplier. Each tile can hold at most one resource.
// Terrain filters are OR-combined; biome filters restrict land resources.
//
// latitude_preference uses normalized absolute latitude:
//   0.0 = equator, 1.0 = poles.
(
    strategic: {
        "iron": (
            category: Strategic,
            eligible_biomes: [],
            eligible_terrain: [FlatLand, Hills],
            latitude_preference: None,
            rarity: 0.018,
            cluster: false,
            cluster_radius: 1,
            min_spacing: 4,
            baseline_fraction: 0.60,
            mineral_affinities: {
